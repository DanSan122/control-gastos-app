# Copiar a .env en la raíz. Completar ambos secretos localmente.
POSTGRES_DB=controlgastos
POSTGRES_USER=controlgastos
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ventana fija compartida en PostgreSQL, en segundos; todos deben ser > 0.
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_IP_LIMIT=30
AUTH_REGISTER_IP_LIMIT=10
AUTH_PASSWORD_USER_LIMIT=5
